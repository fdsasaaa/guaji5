{
  "schema_version": 2,
  "controller_id": "LOTTERY-CONTROLLER-V1",
  "status": "ACTIVE",
  "activated_by_pr": 16,
  "activated_at_commit": "2dc89ebe01f4d2f1804735140ce55c42ee447a5b",
  "stable_source": "main",
  "branch_required": true,
  "direct_main_write_forbidden": true,
  "max_rework_rounds": 3,
  "default_delivery": ["完整交付ZIP"],
  "function_orchestration": {
    "config": "controller/function_orchestration.json",
    "template": "controller/templates/function_orchestration.template.json",
    "scorecard_template": "controller/templates/orchestration_scorecard.template.json",
    "evidence_registry": "controller/feature_evidence_registry.json",
    "coverage_ledger": "controller/function_coverage_ledger.json",
    "validator": "tools/validate_function_orchestration.py",
    "scoring_validator": "tools/validate_orchestration_scoring.py",
    "pr_gate": "tools/validate_scheme_orchestration_gate.py",
    "funding_integrity_validator": "tools/validate_funding_path_integrity.py",
    "funding_objective_config": "controller/funding_objectives.json",
    "funding_objective_schema": "controller/schemas/funding_objective.schema.json",
    "funding_objective_template": "controller/templates/funding_objective.template.json",
    "funding_objective_validator": "tools/validate_funding_objective.py",
    "funding_objective_resolver": "tools/resolve_funding_objective.py",
    "required_for_task_types": ["STANDARD_SCHEME_TASK"],
    "required_evidence": "function_orchestration.json",
    "required_funding_evidence": "funding_path_integrity.json",
    "required_funding_objective_evidence": "funding_objective.json",
    "missing_evidence_failure": "ORCHESTRATION_MISSING",
    "must_pass_before_contract_freeze": true,
    "central_evidence_level_cap_required": true,
    "coverage_ledger_update_required": true,
    "highest_eligible_score_required": true
  },
  "phases": [
    {"id": "INTAKE", "role": "接收一句话任务、解析耐久型/回利型目标并形成结构化任务单；未指定时进入AUTO_COMPARE", "required_outputs": ["task.json", "funding_objective_route.json"]},
    {"id": "PREFLIGHT", "role": "读取main、校验版本、输入、依赖、玩法经济参数、功能覆盖债务与仓库健康状态", "required_outputs": ["preflight.json", "rollback_manifest.json"]},
    {"id": "DIRECTOR", "role": "四类功能画像、八层能力、资金目标、资金四路、更多设置、中央证据、评分与覆盖债务审议", "required_outputs": ["director_decision.json", "function_orchestration.json", "funding_objective.json", "funding_path_integrity.json"]},
    {"id": "CONTRACT_FROZEN", "role": "仅在资金目标、功能编排、资金真实性、逐档回利或耐久边界、证据上限、评分和覆盖账本机器校验通过后冻结合同", "required_outputs": ["design_contract.json"]},
    {"id": "EXECUTION", "role": "按冻结合同生成方案源、TXT、高级倍投配置、行为探针、回测输入和PPT蓝图", "required_outputs": ["execution_manifest.json"]},
    {"id": "VALIDATION", "role": "格式、编码、引用、数据、资金目标、逐档回利、资金暴露、功能编排和运行验证", "required_outputs": ["validation_report.json"]},
    {"id": "AUDIT", "role": "语义、重复、评分、覆盖债务、后验拟合、资金目标一致性、PPT一致性和交付审计", "required_outputs": ["audit_report.json"]},
    {"id": "REWORK", "role": "按失败类型返回对应阶段，最多三轮", "required_outputs": ["rework_record.json"]},
    {"id": "DELIVERY", "role": "生成并核对完整交付ZIP；正式方案、对照和探针必须物理分层并标注轮投/并投设置", "required_outputs": ["delivery_manifest.json"]},
    {"id": "LEARNING", "role": "写入历史、资金目标效果、中央功能覆盖债务、失败证据与规则候选，不自动晋级核心规则", "required_outputs": ["learning_record.json"]},
    {"id": "COMPLETED", "role": "任务完成，所有证据可追踪", "required_outputs": ["completion.json"]}
  ],
  "transitions": {
    "INTAKE": ["PREFLIGHT"],
    "PREFLIGHT": ["DIRECTOR", "BLOCKED"],
    "DIRECTOR": ["CONTRACT_FROZEN", "BLOCKED"],
    "CONTRACT_FROZEN": ["EXECUTION", "DIRECTOR"],
    "EXECUTION": ["VALIDATION", "REWORK", "BLOCKED"],
    "VALIDATION": ["AUDIT", "REWORK", "BLOCKED"],
    "AUDIT": ["DELIVERY", "REWORK", "BLOCKED"],
    "REWORK": ["DIRECTOR", "CONTRACT_FROZEN", "EXECUTION", "VALIDATION", "AUDIT", "BLOCKED"],
    "DELIVERY": ["LEARNING", "REWORK", "BLOCKED"],
    "LEARNING": ["COMPLETED", "BLOCKED"],
    "COMPLETED": [],
    "BLOCKED": []
  },
  "failure_routes": {
    "INPUT_OR_VERSION": "PREFLIGHT",
    "ORCHESTRATION_MISSING": "DIRECTOR",
    "PROFILE_FAMILY_INCOMPLETE": "DIRECTOR",
    "PROFILE_NOT_MATERIAL": "DIRECTOR",
    "FUNDING_REVIEW_INCOMPLETE": "DIRECTOR",
    "FUNDING_OBJECTIVE_MISSING": "DIRECTOR",
    "FUNDING_OBJECTIVE_ROUTE_INVALID": "DIRECTOR",
    "RECOVERY_STAGE_NOT_PROFITABLE": "DIRECTOR",
    "RECOVERY_DEPTH_CONSTRAINT_VIOLATION": "DIRECTOR",
    "DURABLE_PROFIT_CLAIM_UNVERIFIED": "CONTRACT_FROZEN",
    "MORE_SETTINGS_NOT_MATERIAL": "DIRECTOR",
    "UNVERIFIED_FEATURE_SELECTED": "CONTRACT_FROZEN",
    "BASELINE_ONLY_REPEAT_LIMIT": "DIRECTOR",
    "COVERAGE_DEBT_UNRESOLVED": "DIRECTOR",
    "NEW_STATE_AND_ADVANCED_FIRST_USE_CONFLICT": "DIRECTOR",
    "EVIDENCE_LEVEL_EXCEEDS_REGISTRY": "CONTRACT_FROZEN",
    "SCHEME_PR_EVIDENCE_MISSING": "DIRECTOR",
    "COVERAGE_LEDGER_NOT_UPDATED": "DIRECTOR",
    "PERIODIC_FUNDING_PATTERN": "DIRECTOR",
    "ADVANCED_STATE_TRANSITION_INVALID": "DIRECTOR",
    "FUNDING_STRESS_CHECKPOINTS_INCOMPLETE": "DIRECTOR",
    "RANDOM_SIMULATION_TOO_SMALL": "DIRECTOR",
    "IMMATURE_DATA_CLAIM_VIOLATION": "CONTRACT_FROZEN",
    "SCORING_MISSING_OR_INVALID": "DIRECTOR",
    "LOWER_SCORE_SELECTED_WITHOUT_EVIDENCE": "DIRECTOR",
    "LOGIC_OR_OVERFIT": "DIRECTOR",
    "CONTRACT_DRIFT": "CONTRACT_FROZEN",
    "TXT_OR_BUILD": "EXECUTION",
    "DATA_OR_BACKTEST": "VALIDATION",
    "PPT_OR_SEMANTIC": "AUDIT",
    "DELIVERY_INTEGRITY": "DELIVERY"
  },
  "learning_levels": {
    "L1": "自动写入批次事实、资金目标、功能覆盖债务、画像评分和失败证据",
    "L2": "写入规则候选池，保持候选状态",
    "L3": "只有多次证据、样本外验证、治理校验和独立PR通过后才可晋级正式规则"
  },
  "rollback": {
    "base_ref_required": true,
    "base_commit_required_before_write": true,
    "changed_files_hash_required": true,
    "validation_evidence_required": true,
    "failed_version_evidence_must_remain": true,
    "rollback_target": "last_verified_main_commit",
    "force_push_forbidden": true
  },
  "cleanup": {
    "default_action": "PLAN_ONLY",
    "direct_delete_forbidden": true,
    "quarantine_first": true,
    "reference_scan_required": true,
    "restore_manifest_required": true
  }
}

  "ci_block_on_scheme_pr_without_changed_evidence": true,
  "central_evidence_level_cap_required": true,
  "central_coverage_ledger_update_required": true,
  "unverified_feature_formal_selection_forbidden": true,
  "advanced_with_new_state_first_use_forbidden": true,
  "evidence_file_name": "function_orchestration.json",
  "formal_selection_minimum_evidence": "E3",
  "probe_max_periods": 30,
  "required_material_signature_fields": ["number_logic", "trigger", "execution", "funding", "stop", "time_simulation"],
  "more_setting_categories": ["MONITORING", "PROFIT_LOSS_JUMP", "PROFIT_LOSS_STOP", "SIMULATION_REAL_SWITCH", "TIME_WINDOW", "CHANGE_RULE", "BET_DIRECTION", "ROTATION_OR_COMBINATION"],
  "failure_states": [
    "ORCHESTRATION_MISSING",
    "PROFILE_FAMILY_INCOMPLETE",
    "PROFILE_NOT_MATERIAL",
    "FUNDING_REVIEW_INCOMPLETE",
    "FUNDING_OBJECTIVE_MISSING",
    "FUNDING_OBJECTIVE_ROUTE_INVALID",
    "RECOVERY_STAGE_NOT_PROFITABLE",
    "RECOVERY_DEPTH_CONSTRAINT_VIOLATION",
    "DURABLE_PROFIT_CLAIM_UNVERIFIED",
    "MORE_SETTINGS_NOT_MATERIAL",
    "UNVERIFIED_FEATURE_SELECTED",
    "BASELINE_ONLY_REPEAT_LIMIT",
    "COVERAGE_DEBT_UNRESOLVED",
    "NEW_STATE_AND_ADVANCED_FIRST_USE_CONFLICT",
    "EVIDENCE_LEVEL_EXCEEDS_REGISTRY",
    "SCHEME_PR_EVIDENCE_MISSING",
    "COVERAGE_LEDGER_NOT_UPDATED",
    "PERIODIC_FUNDING_PATTERN",
    "ADVANCED_STATE_TRANSITION_INVALID",
    "FUNDING_STRESS_CHECKPOINTS_INCOMPLETE",
    "RANDOM_SIMULATION_TOO_SMALL",
    "IMMATURE_DATA_CLAIM_VIOLATION"
  ]
}
